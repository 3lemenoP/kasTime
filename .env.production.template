# =============================================================================
# KTCS Production Configuration Template
# =============================================================================
# Copy to .env.production and fill in your values.
# NEVER commit this file with real secrets.

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# ?mode=rwc lets SQLite create the file on first run. The ./data path resolves
# relative to the process working directory (WorkingDirectory=/opt/ktcs/calendar
# for systemd; /app for the Docker image, mounted from the calendar-data volume).
DATABASE_URL=sqlite:./data/ktcs-calendar.db?mode=rwc

# -----------------------------------------------------------------------------
# KASPA NETWORK
# -----------------------------------------------------------------------------
# Network: mainnet, testnet-10, testnet-11
KASPA_NETWORK=mainnet

# RPC endpoint URL
KASPA_RPC_URL=wss://kaspa.aspectron.com/wrpc/json/mainnet

# -----------------------------------------------------------------------------
# WALLET (REQUIRED - replace with your keys)
# -----------------------------------------------------------------------------
# Generate with: ktcs wallet generate -n mainnet
CALENDAR_WALLET_KEY=<YOUR_64_HEX_CHAR_PRIVATE_KEY>
CALENDAR_WALLET_ADDRESS=<YOUR_KASPA_ADDRESS>

# Optional: dual-wallet recycling
# RETURN_WALLET_KEY=<YOUR_RETURN_WALLET_KEY>
# RETURN_WALLET_ADDRESS=<YOUR_RETURN_WALLET_ADDRESS>
# RECYCLE_THRESHOLD_SOMPI=100000000
# RECYCLE_POLL_INTERVAL_SECS=30

# -----------------------------------------------------------------------------
# MODE
# -----------------------------------------------------------------------------
KTCS_MOCK_MODE=false

# KTCS_ENVIRONMENT: development | testing | production
#
# IMPORTANT: this ships as "development" ON PURPOSE. See the AUTHENTICATION
# section below -- the server HARD-FAILS at startup if KTCS_ENVIRONMENT=production
# while REQUIRE_API_KEY=false, and the browser frontend cannot send an API key.
# So a working public browser frontend currently requires either:
#   (a) KTCS_ENVIRONMENT != production with REQUIRE_API_KEY=false (this default), OR
#   (b) a server-side change that exempts reads/WS from the API key (see below).
KTCS_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
# The server binds to BIND_ADDRESS. (There is NO separate PORT variable -- the
# old `PORT` key was dead config and has been removed. Set the port here.)
BIND_ADDRESS=0.0.0.0:3001
KTCS_PUBLIC_URL=https://your-domain.com

# CORS: your frontend domain(s), comma-separated
CORS_ORIGINS=https://your-domain.com

# TRUST_PROXY: set true ONLY when the server sits behind a reverse proxy you
# control (nginx/traefik) that sets X-Forwarded-For / X-Real-IP. When true, the
# client IP used for rate limiting is taken from those headers instead of the
# TCP peer. Set it false if the server is directly internet-facing, otherwise
# clients can spoof X-Forwarded-For to evade rate limits.
# NOTE (flagged for the calendar/security agent): the current XFF extractor
# trusts the first X-Forwarded-For entry, which nginx makes attacker-controllable
# via $proxy_add_x_forwarded_for -- prefer X-Real-IP / rightmost entry (analysis
# section 4). Both the Docker frontend.conf and bare-metal ktcs.conf set these
# headers, so TRUST_PROXY=true is correct for both shipped deployments.
TRUST_PROXY=true

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# THE 401 WALL -- READ BEFORE ENABLING REQUIRE_API_KEY
# -----------------------------------------------------------------------------
# The API-key middleware currently guards ALL /v1 routes -- including the read
# path (GET /v1/stamp/:id), POST /v1/verify, AND the WebSocket /v1/stream.
# The browser frontend never sends an X-API-Key header (there is no such header
# anywhere in src/), and browsers CANNOT set custom headers on a WebSocket
# handshake at all. Therefore:
#
#   REQUIRE_API_KEY=true  +  a public browser frontend  ==  every call returns 401.
#
# To run WITH the API key enabled you must do one of:
#   1. (server change, owned by the calendar agent) exempt reads + WS from the
#      key so only write ops (POST /v1/stamp) require it -- the recommended fix;
#      then set REQUIRE_API_KEY=true and KTCS_ENVIRONMENT=production, OR
#   2. add a query-param key for WS + have nginx inject X-API-Key on the /api/
#      (Docker) or /v1/ (bare-metal) proxy location for REST.
#
# Until one of those lands, this template ships a WORKING public config:
# authentication DISABLED. If you do not need a public browser frontend (e.g.
# CLI-only or a trusted proxy that injects the key), set REQUIRE_API_KEY=true
# and provide a >=16 char API_KEY below, and switch KTCS_ENVIRONMENT=production.
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# API_KEY must be at least 16 characters when REQUIRE_API_KEY=true.
API_KEY=<YOUR_SECRET_API_KEY_MIN_16_CHARS>
REQUIRE_API_KEY=false

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# These are the app-level (governor) limits. Keep them in sync with the nginx
# limit_req zone in deploy/nginx/ktcs.conf (rate=10r/s, burst=50) so the two
# layers agree. This is the single documented value: 10 req/s, burst 50.
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=50
MAX_BODY_SIZE=10485760

# -----------------------------------------------------------------------------
# TRANSACTION SETTINGS
# -----------------------------------------------------------------------------
FEE_PER_GRAM=10
CONFIRMATION_TIMEOUT_MS=60000
# NOTE: KTCS_INCLUDE_MAGIC was removed -- it appeared in zero source files (dead
# config key). Do not re-add it.

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
RUST_LOG=info,ktcs_calendar=info
