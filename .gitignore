# Dependencies
node_modules/

# Build outputs
dist/
build/
site/

# Environment files (may contain secrets)
.env
.env.local
.env.*.local
.env.production
ktcs-calendar/.env

# Private keys (DO NOT COMMIT)
*.key
*.pem

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/

# Claude Code
.claude/

# Build artifacts
tsconfig.tsbuildinfo

# Database
ktcs-calendar/data/*.db

# Misc
*.local
*.rlib
target/

# NOTE: Cargo.lock is intentionally TRACKED (not ignored). This repo's primary
# artifacts are binaries (ktcs-cli, ktcs-calendar), so a committed lockfile is
# required for reproducible builds across CI, Docker, and host toolchains.
