# =============================================================================
# KTCS Calendar Server Configuration
# =============================================================================
# Copy to .env and customize for your environment

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# SQLite database URL (with create mode for auto-creation)
DATABASE_URL=sqlite:./data/ktcs-calendar.db?mode=rwc

# -----------------------------------------------------------------------------
# KASPA NETWORK
# -----------------------------------------------------------------------------
# Network: mainnet, testnet-10, testnet-11
KASPA_NETWORK=testnet-11

# RPC endpoint URL
# For local node: ws://127.0.0.1:16210 (testnet-11) or ws://127.0.0.1:16110 (mainnet)
# For public resolver: wss://resolver.kaspa.stream/wrpc/testnet-11
KASPA_RPC_URL=wss://resolver.kaspa.stream/wrpc/testnet-11

# -----------------------------------------------------------------------------
# WALLET CONFIGURATION (STAMP wallet)
# -----------------------------------------------------------------------------
# Calendar wallet private key (64 hex characters / 32 bytes)
# REQUIRED when KTCS_MOCK_MODE=false
# SECURITY: Keep this secret! Use proper secret management in production.
# Generate with: ktcs wallet generate -n testnet
CALENDAR_WALLET_KEY=

# Calendar wallet address (optional - derived from key if not set)
# Used for display purposes and UTXO fetching
CALENDAR_WALLET_ADDRESS=

# -----------------------------------------------------------------------------
# DUAL-WALLET RECYCLING (optional)
# -----------------------------------------------------------------------------
# When configured, change from STAMP transactions goes to RETURN wallet,
# which automatically recycles funds back to STAMP wallet.
# This creates a self-sustaining loop - only losing transaction fees.

# Return wallet private key (64 hex characters / 32 bytes)
# Must be different from CALENDAR_WALLET_KEY
# Generate with: ktcs wallet generate -n testnet
RETURN_WALLET_KEY=

# Return wallet address (optional - derived from key if not set)
RETURN_WALLET_ADDRESS=

# Minimum balance (sompi) before recycling (default: 100000000 = 1 KAS)
RECYCLE_THRESHOLD_SOMPI=100000000

# Polling interval for recycle checks (seconds, default: 30)
RECYCLE_POLL_INTERVAL_SECS=30

# -----------------------------------------------------------------------------
# MODE CONFIGURATION
# -----------------------------------------------------------------------------
# Mock mode: true = fake attestations (testing only), false = real blockchain
# WARNING: Mock mode timestamps are NOT anchored to the blockchain!
KTCS_MOCK_MODE=false

# Environment: development, testing, production
# Mock mode is blocked in production environment
KTCS_ENVIRONMENT=testnet

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
PORT=3001
BIND_ADDRESS=0.0.0.0:3001
KTCS_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# TRANSACTION SETTINGS
# -----------------------------------------------------------------------------
# Fee per gram in sompi (1 = minimum)
FEE_PER_GRAM=1

# Confirmation timeout in milliseconds
CONFIRMATION_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# Requests per second per IP
RATE_LIMIT_PER_SECOND=10

# Burst size (max requests before rate limiting kicks in)
RATE_LIMIT_BURST=50

# Maximum request body size in bytes (default 10MB)
MAX_BODY_SIZE=10485760

# -----------------------------------------------------------------------------
# AUTHENTICATION (optional)
# -----------------------------------------------------------------------------
# API key for protected endpoints (minimum 16 characters)
# API_KEY=your-secret-api-key-here

# Require API key for write operations
REQUIRE_API_KEY=false

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
RUST_LOG=info,ktcs_calendar=debug
