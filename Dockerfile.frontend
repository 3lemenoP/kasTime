# =============================================================================
# KTCS Frontend - Multi-stage Docker Build
# =============================================================================
# Build: docker build -f Dockerfile.frontend -t ktcs-frontend .
# Run:   docker run -p 80:80 ktcs-frontend

# -----------------------------------------------------------------------------
# Stage 1: Build the React application
# -----------------------------------------------------------------------------
FROM node:20-slim AS builder

WORKDIR /app

# Copy package files for dependency caching
COPY package.json package-lock.json ./

RUN npm ci

# Copy source files
COPY index.html tsconfig.json tsconfig.tsbuildinfo vite.config.ts ./
COPY src/ src/
COPY public/ public/

# Build with production calendar URL (override at build time)
ARG VITE_CALENDAR_URL=/api
ENV VITE_CALENDAR_URL=${VITE_CALENDAR_URL}

RUN npm run build

# -----------------------------------------------------------------------------
# Stage 2: Serve with nginx
# -----------------------------------------------------------------------------
FROM nginx:1.25-alpine

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Add custom nginx config for SPA + API proxy
COPY deploy/nginx/frontend.conf /etc/nginx/conf.d/default.conf

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Non-root nginx (optional, requires nginx.conf changes)
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
